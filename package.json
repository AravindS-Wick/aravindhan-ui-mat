{
  "name": "@aravi1008/ui-mat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework wrapper packages for @aravi1008/ui",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "^9.4.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=3.1.4",
      "lodash": ">=4.18.0"
    }
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
