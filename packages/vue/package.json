{
  "name": "@aravi1008/ui-vue",
  "version": "0.1.0",
  "description": "Vue 3 components for @aravi1008/ui — MUI-style props mapped to av- CSS classes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@aravi1008/ui": "*",
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@aravi1008/ui": "*",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vite-plugin-dts": "^3.9.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "aravi1008",
    "design-system"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aravi1008/aravindhan-ui-mat"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "canvas-confetti": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "radix-vue": "^1.9.17"
  }
}
