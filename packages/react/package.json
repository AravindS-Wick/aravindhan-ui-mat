{
  "name": "@aravi1008/ui-react",
  "version": "0.1.0",
  "description": "React 18 components for @aravi1008/ui — MUI-style props mapped to av- CSS classes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "public"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react-dom": { "optional": false }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": ["react", "ui", "components", "aravi1008", "design-system", "typescript"],
  "license": "MIT",
  "homepage": "https://github.com/AravindS-Wick/aravindhan-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/AravindS-Wick/aravindhan-ui"
  },
  "bugs": {
    "url": "https://github.com/AravindS-Wick/aravindhan-ui/issues"
  }
}
